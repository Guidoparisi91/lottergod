[gd_scene format=3]

[ext_resource type="Script" path="res://ui/lobby/lobby.gd" id="1"]

[node name="Lobby" type="Control"]
script = ExtResource("1")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -130.0
offset_top = -120.0
offset_right = 130.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="VBox"]
text = "LotterGod"
horizontal_alignment = 1

[node name="Sep" type="HSeparator" parent="VBox"]

[node name="IPInput" type="LineEdit" parent="VBox"]
placeholder_text = "IP del host  (default: 127.0.0.1)"
custom_minimum_size = Vector2(260, 0)

[node name="BtnHost" type="Button" parent="VBox"]
text = "Hostear"

[node name="BtnJoin" type="Button" parent="VBox"]
text = "Unirse"

[node name="BtnStart" type="Button" parent="VBox"]
text = "Iniciar partida"

[node name="StatusLabel" type="Label" parent="VBox"]
text = ""

[node name="PeersLabel" type="Label" parent="VBox"]
text = "Jugadores: 0"

[connection signal="pressed" from="VBox/BtnHost" to="." method="_on_host_pressed"]
[connection signal="pressed" from="VBox/BtnJoin" to="." method="_on_join_pressed"]
[connection signal="pressed" from="VBox/BtnStart" to="." method="_on_start_pressed"]
